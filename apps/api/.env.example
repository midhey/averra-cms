# Скопируй в .env, если нужно поменять значения по умолчанию

# На сервере обязательно NODE_ENV=production: тогда API требует свои AUTH_SECRET, ADMIN_URL
# и API_URL и ставит cookie только по HTTPS. Без NODE_ENV — разработка
# NODE_ENV=development

PORT=4000

# Папка встроенного Postgres (PGlite) для разработки
PGLITE_DIR=.data/pglite

# Папка с картинками медиатеки (потом её место займёт S3)
# MEDIA_DIR=.data/media

# Самый большой файл, который принимает медиатека, в байтах (по умолчанию 10 МБ)
# MEDIA_MAX_BYTES=10485760

# Владелец, которого API создаёт при старте, если в базе ещё нет ни одного пользователя.
# ТОЛЬКО ДЛЯ РАЗРАБОТКИ: работает лишь в учебном режиме pnpm dev (флаг --dev) при
# NODE_ENV=development и адресах на localhost; тогда же API заводит демо-сайт.
# Значения ниже учебные — не бери их для настоящей админки
DEV_OWNER_EMAIL=owner@example.test
DEV_OWNER_PASSWORD=dev-password-change-me

# Подпись cookie сессии, своя, от 32 символов: openssl rand -base64 32.
# Без неё API работает на учебном секрете из репозитория, и только в учебном режиме: флаг --dev
# (его ставит pnpm dev), NODE_ENV не production, ADMIN_URL и API_URL на localhost. Отвечает он
# тогда лишь на запросы к localhost с этого компьютера. Без флага или вне localhost API без
# AUTH_SECRET не стартует. pnpm dev на сервере не запускай: прокси вроде nginx обходит проверку Host.
# Учебный секрет и его варианты (пробелы, кавычки, регистр, его часть) вне учебного режима не пройдут
# AUTH_SECRET=

# Адрес админки: только с него принимаются запросы с cookie, и на него ведут ссылки в письмах
# (сброс пароля, приглашения). В проде обязателен
# ADMIN_URL=http://localhost:5173

# Адрес API снаружи. В проде обязателен
# API_URL=http://localhost:4000

# true, если перед API стоит прокси (Caddy), который сам ставит X-Forwarded-For
# TRUST_PROXY=false

# ── Почта ──────────────────────────────────────────────────────────────────────────────────
# smtp — настоящая отправка, file — письма в папку MAIL_DIR (только разработка), off — выключена.
# Не задано: есть SMTP_HOST — smtp; учебный режим pnpm dev — file; иначе почта выключена,
# и админка честно говорит, что сброс пароля и уведомления не работают
# MAIL_TRANSPORT=file

# SMTP-сервер. Только шифрование: 465 — TLS сразу, 587 — обязательный STARTTLS.
# Сертификат сервера проверяется всегда, выключить проверку нельзя.
# Провайдер — российский (Яндекс 360, Unisender Go…): в письмах о заявках персональные данные
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# Для другого порта режим задаётся явно: tls или starttls
# SMTP_SECURITY=tls
# SMTP_USER=noreply@example.ru
# Пароль только здесь (лучше — пароль приложения у провайдера). В базу, логи и ответы API он не попадает
# SMTP_PASSWORD=

# Отправитель — адрес на своём домене с настроенными SPF, DKIM и DMARC (см. README, «Почта»)
# MAIL_FROM=noreply@example.ru
# MAIL_FROM_NAME=Averra CMS

# Папка файлового ящика для разработки: письма лежат там парами .eml и .json
# MAIL_DIR=.data/mail

# Сколько раз пробовать отправить письмо (пауза растёт: 1, 3, 9… минут, не больше 6 часов)
# MAIL_MAX_ATTEMPTS=8
# Через сколько дней удалять письма из очереди в любом статусе (в них персональные данные)
# MAIL_RETENTION_DAYS=30
