{
  "name": "@cms/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./testing": "./src/testing.ts"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "user:create": "tsx src/cli/user-create.ts",
    "member:add": "tsx src/cli/member-add.ts",
    "token:create": "tsx src/cli/token-create.ts",
    "token:list": "tsx src/cli/token-list.ts",
    "token:revoke": "tsx src/cli/token-revoke.ts"
  },
  "dependencies": {
    "@cms/schema": "workspace:*",
    "@cms/tokens": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.11",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
