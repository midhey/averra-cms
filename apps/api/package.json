{
  "name": "@averra/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./testing": "./src/testing.ts",
    "./testing/certs": "./src/mail/testing/certs.ts",
    "./testing/smtp": "./src/mail/testing/smtp.ts"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts --dev",
    "start": "tsx src/index.ts",
    "build": "node scripts/build.ts",
    "start:prod": "node --enable-source-maps dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "user:create": "tsx src/cli/user-create.ts",
    "user:password": "tsx src/cli/user-password.ts",
    "site:create": "tsx src/cli/site-create.ts",
    "member:add": "tsx src/cli/member-add.ts",
    "member:invite": "tsx src/cli/member-invite.ts",
    "token:create": "tsx src/cli/token-create.ts",
    "token:list": "tsx src/cli/token-list.ts",
    "token:revoke": "tsx src/cli/token-revoke.ts",
    "mail:test": "tsx src/cli/mail-test.ts"
  },
  "dependencies": {
    "@averra/schema": "workspace:*",
    "@averra/tokens": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "hono": "catalog:",
    "nodemailer": "^10.1.0",
    "pg": "8.23.1",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "selfsigned": "^5.5.0",
    "smtp-server": "^3.19.21",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
