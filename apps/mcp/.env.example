# Проще всего — без этого файла: выпусти токен в админке (Установка → Доступ для ИИ) и положи
# готовый фрагмент .mcp.json в корень репозитория. Этот файл — для токена из команды
#   pnpm token:create --name mcp
# Скопируй в .env (он в .gitignore) и вставь токен из её вывода. Токен показывается один раз,
# по умолчанию — «только черновики»
CMS_API_TOKEN=

# Адрес API, если он не на стандартном порту
# CMS_API_URL=http://localhost:4000
