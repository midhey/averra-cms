# Скопируй в .env (он в .gitignore), если нужно поменять значения по умолчанию

# Адрес API
# CMS_API_URL=http://localhost:4000

# Какой сайт собирать. Не задан — сайт установки (одна установка — один сайт). Нужен, только если
# в старой базе разработки сайтов несколько, а показать надо не первый
# CMS_SITE_ID=

# Куда ведут ссылки на картинки и формы: api (по умолчанию) — на CMS_API_URL; relative — от корня
# сайта (/media/…, /api/forms/…), так собирает сайт публикация на сервере (её ставит API сам)
# CMS_LINKS=api
