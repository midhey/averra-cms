# Скопируй в .env (он в .gitignore)

# Какой сайт собирать. id виден в адресе админки: /sites/<id>.
# Демо-сайт свежей базы всегда d0000000-0000-4000-8000-000000000001
CMS_SITE_ID=d0000000-0000-4000-8000-000000000001

# Адрес API
# CMS_API_URL=http://localhost:4000

# Куда ведут ссылки на картинки и формы: api (по умолчанию) — на CMS_API_URL; relative — от корня
# сайта (/media/…, /api/forms/…), так собирает сайт публикация на сервере (её ставит API сам)
# CMS_LINKS=api
