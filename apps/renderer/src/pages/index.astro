---
import { Page } from '@cms/blocks'
import '@cms/blocks/base.css'
import { demoPage, PageContent } from '@cms/schema'
import { defaultTheme, themeToCss } from '@cms/tokens'

// Пока показываем демо-лендинг. На шаге 4 рендерер будет брать сайт из API
const content = PageContent.parse(demoPage)
const themeCss = themeToCss(defaultTheme)
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ремонт квартир под ключ</title>
    <style is:inline set:html={themeCss}></style>
  </head>
  <body>
    <Page content={content} />
  </body>
</html>
