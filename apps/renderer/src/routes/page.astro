---
import { Page } from '@cms/blocks'
import '@cms/blocks/base.css'
import { themeToCss } from '@cms/tokens'
import { loadSnapshot } from '../lib/snapshot'

// Главная страница сайта хранится со slug «index» и открывается по корню
export async function getStaticPaths() {
  const { pages } = await loadSnapshot()
  return pages.map((page) => ({ params: { slug: page.slug === 'index' ? undefined : page.slug } }))
}

// Содержимое грузим здесь, а не в getStaticPaths: в dev-режиме этот код выполняется
// на каждый запрос, и опубликованные правки видны после обновления страницы
const { site, pages } = await loadSnapshot()
const slug = Astro.params.slug ?? 'index'
const page = pages.find((candidate) => candidate.slug === slug)
if (!page) throw new Error(`Страница «${slug}» не опубликована`)
const themeCss = themeToCss(site.theme)
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title}</title>
    <style is:inline set:html={themeCss}></style>
  </head>
  <body>
    <Page content={page.content} />
  </body>
</html>
