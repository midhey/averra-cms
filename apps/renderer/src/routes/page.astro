---
import {
  cookieNoticeView,
  headerRowButton,
  headerScriptNeeded,
  LegalFooter,
  Page,
  SiteHeader,
  siteHeaderView,
} from '@averra/blocks'
import '@averra/blocks/base.css'
import {
  findRedirect,
  headerContacts,
  MAIN_PAGE_SLUG,
  NOT_FOUND_PAGE_SLUG,
  redirectLocation,
} from '@averra/schema'
import { themeToCss } from '@averra/tokens'
import CookieConsent from '../components/CookieConsent.astro'
import SiteHeaderScript from '../components/SiteHeaderScript.astro'
import VideoPlayer from '../components/VideoPlayer.astro'
import { siteFontCss, siteFontFiles } from '../lib/fonts'
import { analyticsHead, faqJsonLd, headTags, organizationJsonLd } from '../lib/seo'
import { formActionFor, loadSnapshot, notFoundPage } from '../lib/snapshot'

// Маршрут подключается в astro.config.mjs: при сборке он статический, в dev — по запросу.
// Поэтому в dev Astro пишет в лог «getStaticPaths() ignored in dynamic page…» и советует
// prerender = true. Так и задумано: совет не выполняем, getStaticPaths нужен только сборке.
// Главная страница сайта хранится со slug «index» и открывается по корню. Страница 404 есть
// всегда — своя или стандартная: Astro пишет её в 404.html, её отдаёт сервер на чужих адресах
export async function getStaticPaths() {
  const { pages } = await loadSnapshot()
  const slugs = new Set([...pages.map((page) => page.slug), NOT_FOUND_PAGE_SLUG])
  return [...slugs].map((slug) => ({
    params: { slug: slug === MAIN_PAGE_SLUG ? undefined : slug },
  }))
}

// Содержимое грузим здесь, а не в getStaticPaths: в dev-режиме этот код выполняется
// на каждый запрос, и опубликованные правки видны после обновления страницы
const { site, pages, media } = await loadSnapshot()
// /404 в dev — отдельный маршрут (astro.config.mjs): иначе Astro показал бы там свою заглушку
const devNotFound = Astro.routePattern === '/404'
if (devNotFound) Astro.response.status = 404
const slug = devNotFound ? NOT_FOUND_PAGE_SLUG : (Astro.params.slug ?? MAIN_PAGE_SLUG)
// /index — не страница: главная только по корню, а в сборке папки /index/ нет
const found =
  Astro.params.slug === MAIN_PAGE_SLUG
    ? undefined
    : slug === NOT_FOUND_PAGE_SLUG
      ? notFoundPage(pages)
      : pages.find((candidate) => candidate.slug === slug)
let page = found
if (!page) {
  // При сборке сюда не попасть: собираются только опубликованные страницы и 404. В dev адрес
  // может быть любым — как на сервере, сначала редирект из таблицы «SEO», потом страница 404
  const to = findRedirect(site.settings.redirects, Astro.url.pathname)
  if (to) return Astro.redirect(redirectLocation(to, Astro.url.search), 301)
  Astro.response.status = 404
  page = notFoundPage(pages)
}
const seoSite = { name: site.name, url: site.url, theme: site.theme, settings: site.settings }
const head = headTags({ site: seoSite, page, media })
const scripts = [
  ...analyticsHead(site.settings),
  organizationJsonLd(seoSite, page, media) ?? '',
  faqJsonLd(seoSite, page) ?? '',
]
// Шрифты темы — свои файлы с сервера сайта (/_fonts/), перед переменными темы
const themeCss = siteFontCss(await siteFontFiles(site.theme)) + themeToCss(site.theme)
// Cookie-уведомление и подвал с документами: ссылка на политику — только на опубликованную страницу
const cookies = cookieNoticeView(
  site.settings,
  pages.map((candidate) => candidate.slug),
)
// Шапка сайта: опубликованная, если страница её не скрыла. Ссылки меню — только на опубликованные
// страницы и блоки, телефон и адрес — из «SEO → Организация»
const header = siteHeaderView({
  header: site.header,
  siteName: site.name,
  page,
  pages: pages.map((candidate) => ({
    slug: candidate.slug,
    blockIds: candidate.content.blocks.map((block) => block.id),
  })),
  contacts: headerContacts(site.settings.organization),
})
// Скрипт плеера — только на страницах с блоком «Видео»
const hasVideo = page.content.blocks.some((block) => block.type === 'video')
---

<html
  lang={site.settings.language}
  data-sticky-header={header?.sticky ? header.layout : undefined}
  data-sticky-header-row={header?.sticky && headerRowButton(header) ? '' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Fragment set:html={head.join('\n')} />
    <style is:inline set:html={themeCss}></style>
    <Fragment set:html={scripts.join('\n')} />
  </head>
  <body>
    {header && <SiteHeader view={header} media={media} />}
    <Page content={page.content} media={media} formAction={formActionFor(site.id, page.slug)} />
    <LegalFooter {...cookies.footer} />
    {cookies.notice && <CookieConsent notice={cookies.notice} />}
    {hasVideo && <VideoPlayer />}
    {headerScriptNeeded(header) && <SiteHeaderScript />}
  </body>
</html>
