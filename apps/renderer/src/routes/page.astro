---
import {
  consentPageHref,
  cookieNoticeView,
  customBlocksCss,
  FooterSlot,
  HeaderSlot,
  headerMenuRow,
  headerRowButton,
  headerScriptNeeded,
  LegalFooter,
  Page,
  SiteWindows,
  settlePlace,
  siteFooterView,
  siteHeaderView,
  siteWindowView,
  themeBackgroundCss,
  windowCssForPage,
  windowsAndBehaviors,
} from '@averra/blocks'
import '@averra/blocks/base.css'
import {
  customBlockKeysOf,
  FOOTER_FORM_ID,
  findRedirect,
  footerContacts,
  headerContacts,
  MAIN_PAGE_SLUG,
  NOT_FOUND_PAGE_SLUG,
  redirectLocation,
} from '@averra/schema'
import { themeToCss } from '@averra/tokens'
import CookieConsent from '../components/CookieConsent.astro'
import SiteBehaviors from '../components/SiteBehaviors.astro'
import SiteHeaderScript from '../components/SiteHeaderScript.astro'
import VideoPlayer from '../components/VideoPlayer.astro'
import { siteFontCss, siteFontFiles } from '../lib/fonts'
import { pageScriptFiles, siteCspOf } from '../lib/scripts'
import { faqJsonLd, headTags, organizationJsonLd } from '../lib/seo'
import { apiOrigin, formActionFor, loadSnapshot, notFoundPage } from '../lib/snapshot'

// Маршрут подключается в astro.config.mjs: при сборке он статический, в dev — по запросу.
// Поэтому в dev Astro пишет в лог «getStaticPaths() ignored in dynamic page…» и советует
// prerender = true. Так и задумано: совет не выполняем, getStaticPaths нужен только сборке.
// Главная страница сайта хранится со slug «index» и открывается по корню. Страница 404 есть
// всегда — своя или стандартная: Astro пишет её в 404.html, её отдаёт сервер на чужих адресах
export async function getStaticPaths() {
  const { pages } = await loadSnapshot()
  const slugs = new Set([...pages.map((page) => page.slug), NOT_FOUND_PAGE_SLUG])
  return [...slugs].map((slug) => ({
    params: { slug: slug === MAIN_PAGE_SLUG ? undefined : slug },
  }))
}

// Содержимое грузим здесь, а не в getStaticPaths: в dev-режиме этот код выполняется
// на каждый запрос, и опубликованные правки видны после обновления страницы
const { site, pages, media, customBlocks } = await loadSnapshot()
// /404 в dev — отдельный маршрут (astro.config.mjs): иначе Astro показал бы там свою заглушку
const devNotFound = Astro.routePattern === '/404'
if (devNotFound) Astro.response.status = 404
const slug = devNotFound ? NOT_FOUND_PAGE_SLUG : (Astro.params.slug ?? MAIN_PAGE_SLUG)
// /index — не страница: главная только по корню, а в сборке папки /index/ нет
const found =
  Astro.params.slug === MAIN_PAGE_SLUG
    ? undefined
    : slug === NOT_FOUND_PAGE_SLUG
      ? notFoundPage(pages)
      : pages.find((candidate) => candidate.slug === slug)
let page = found
if (!page) {
  // При сборке сюда не попасть: собираются только опубликованные страницы и 404. В dev адрес
  // может быть любым — как на сервере, сначала редирект из таблицы «SEO», потом страница 404
  const to = findRedirect(site.settings.redirects, Astro.url.pathname)
  if (to) return Astro.redirect(redirectLocation(to, Astro.url.search), 301)
  Astro.response.status = 404
  page = notFoundPage(pages)
}
const seoSite = { name: site.name, url: site.url, theme: site.theme, settings: site.settings }
const head = headTags({ site: seoSite, page, media })
// Разметка для поисковиков — данные (application/ld+json), а не скрипт: CSP её не касается.
// Счётчики аналитики вставляет модуль cookie-уведомления, inline-скриптов на сайте нет
const jsonLd = [organizationJsonLd(seoSite, page, media) ?? '', faqJsonLd(seoSite, page) ?? '']
// Шрифты темы — свои файлы с сервера сайта (/_fonts/), перед переменными темы. Фон-картинка
// страницы и свой CSS окон — тоже тема: после переменных
const themeCss =
  siteFontCss(await siteFontFiles(site.theme)) +
  themeToCss(site.theme) +
  themeBackgroundCss(site.theme, media)
// Cookie-уведомление и ссылки на документы: ссылка на политику — только на опубликованную страницу
const cookies = cookieNoticeView(
  site.settings,
  pages.map((candidate) => candidate.slug),
)
const consentHref = consentPageHref(pages.map((candidate) => candidate.slug))
// Шапка сайта: опубликованная, если страница её не скрыла. Ссылки меню — только на опубликованные
// страницы и блоки, телефон и адрес — из «SEO → Организация». Своему виду шапки — ещё реквизиты,
// документы и год: всё это шаблон получает данными
const headerView = siteHeaderView({
  header: site.header,
  siteName: site.name,
  page,
  pages: pages.map((candidate) => ({
    slug: candidate.slug,
    blockIds: candidate.content.blocks.map((block) => block.id),
  })),
  contacts: headerContacts(site.settings.organization),
  organization: footerContacts(site.settings.organization),
  legal: { ...cookies.footer, consentHref },
  year: new Date().getFullYear(),
})
// Подвал: опубликованный, если страница его не скрыла (иначе — прежняя полоса с документами).
// Разделы — пункты опубликованного меню шапки, логотип — её же, реквизиты и контакты — из «SEO →
// Организация», согласие — ссылкой, если его включили и страница опубликована, форма «Перезвоните
// мне» шлёт заявку в API с адресом этой страницы. Год — год сборки
const footerView = siteFooterView({
  footer: site.footer,
  siteName: site.name,
  page,
  header: site.header,
  pages: pages.map((candidate) => ({
    slug: candidate.slug,
    blockIds: candidate.content.blocks.map((block) => block.id),
  })),
  contacts: footerContacts(site.settings.organization),
  legal: cookies.footer,
  consentHref,
  // Стандартной 404 нет в базе — API заявку с неё не примет, поэтому формы на ней нет (null)
  formAction: pages.includes(page) ? formActionFor(site.id, page.slug)(FOOTER_FORM_ID) : null,
  year: new Date().getFullYear(),
})
const pageIds = page.content.blocks.map((block) => block.id)
// Свой вид шапки или подвала не вывелся — на сайте стандартный, причина — в журнале сборки
const placeError = (message: string) => console.warn(`Страница ${page.slug}: ${message}`)
// Выводится ли свой вид, решаем до вёрстки <html>: метки липкой шапки, CSS и скрипт своего вида —
// только когда он на странице, у стандартной на его месте не остаётся чужого
const headerPlace = headerView
  ? settlePlace(headerView, 'header', customBlocks, media, pageIds, placeError)
  : undefined
const footerPlace = footerView
  ? settlePlace(footerView, 'footer', customBlocks, media, pageIds, placeError)
  : undefined
const header = headerPlace?.view ?? null
const footer = footerPlace?.view ?? null
// Свои шапка и подвал — свои блоки с местом: их CSS и скрипт выводятся так же, как у блоков страницы
const placeKeys = [header?.custom?.key, footer?.custom?.key].filter(
  (key): key is string => key !== undefined,
)
const pageKeys = [...new Set([...placeKeys, ...customBlockKeysOf(page.content)])]
// Окна сайта: страницы-окна, на которые ведут ссылки этой страницы, — закрытыми <dialog> после
// подвала; скрипт поведений — только если есть окно или поведение (data-av-*, «Появление при
// прокрутке», плавный FAQ). Свои блоки окон — со своими CSS и скриптами, как блоки страницы
const needed = windowsAndBehaviors({
  page,
  pages,
  chromeLinks: [
    ...(header?.menu ?? []),
    ...(header?.button ? [header.button] : []),
    ...(footer?.sections ?? []),
  ],
  customBlocks,
  ownKeys: [...customBlockKeysOf(page.content)],
  placeHtml: [headerPlace?.html, footerPlace?.html].filter(
    (html): html is string => html !== undefined,
  ),
})
const windows = needed.windows.flatMap((candidate) => {
  const view = siteWindowView(candidate, (slug) => formActionFor(site.id, slug))
  return view ? [view] : []
})
const ownKeys = [...new Set([...pageKeys, ...needed.windowKeys])]
// CSS своих блоков страницы — один раз на тип, после темы: роли темы в нём уже определены
const customCss =
  customBlocksCss(ownKeys, customBlocks, media) +
  (windows.length > 0 ? windowCssForPage(site.theme.windowCss, media) : '')
// Свой блок, чьи данные не подходят под опубликованное определение, на сайт не попадает: сборка
// идёт дальше, а причина — в журнале сборки
const customBlockError = (blockId: string, message: string) =>
  console.warn(`Страница ${page.slug}, свой блок #${blockId} не выведен: ${message}`)
// Скрипт плеера — только на страницах с блоком «Видео», в том числе в окне
const hasVideo = needed.video
// Свой JS: скрипт сайта и скрипты своих блоков этой страницы — файлами /_scripts/, каждый один раз
// (lib/scripts.ts). Без них страница работает: контент, ссылки и формы — обычный HTML
const ownScripts = pageScriptFiles({
  siteScript: site.script,
  blockKeys: ownKeys,
  customBlocks,
})
// CSP: на сервере её ставит Caddy из _averra/csp.txt релиза (маршрут csp.ts), в dev — эта страница
// той же функцией. При сборке заголовки страницы не пишутся никуда
if (import.meta.env.DEV) {
  Astro.response.headers.set(
    'content-security-policy',
    siteCspOf({
      analytics: site.settings.analytics,
      siteScript: site.script,
      apiOrigin: apiOrigin(),
    }),
  )
}
---

<html
  lang={site.settings.language}
  data-sticky-header={header?.sticky ? (header.custom ? 'custom' : header.layout) : undefined}
  data-sticky-header-row={header?.sticky && !header.custom && headerRowButton(header) ? '' : undefined}
  data-sticky-header-menu-row={header?.sticky && !header.custom && headerMenuRow(header) ? '' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Fragment set:html={head.join('\n')} />
    <style is:inline set:html={themeCss}></style>
    {customCss && <style is:inline set:html={customCss} />}
    <Fragment set:html={jsonLd.join('\n')} />
  </head>
  <body>
    {
      header && (
        <HeaderSlot
          view={header}
          media={media}
          definitions={customBlocks}
          pageIds={pageIds}
          html={headerPlace?.html}
        />
      )
    }
    <Page
      content={page.content}
      media={media}
      formAction={formActionFor(site.id, page.slug)}
      customBlocks={customBlocks}
      onCustomBlockError={customBlockError}
    />
    {
      footer ? (
        <FooterSlot
          view={footer}
          media={media}
          definitions={customBlocks}
          pageIds={pageIds}
          html={footerPlace?.html}
        />
      ) : (
        <LegalFooter {...cookies.footer} />
      )
    }
    {
      windows.length > 0 && (
        <SiteWindows
          windows={windows}
          media={media}
          customBlocks={customBlocks}
          metrika={site.settings.analytics.metrika}
          onCustomBlockError={customBlockError}
        />
      )
    }
    {cookies.notice && <CookieConsent notice={cookies.notice} />}
    {hasVideo && <VideoPlayer />}
    {headerScriptNeeded(header) && <SiteHeaderScript />}
    {needed.behaviors && <SiteBehaviors />}
    {ownScripts.map((file) => <script is:inline type="module" src={file.src} />)}
  </body>
</html>
