<div class="signup">
  <div class="signup__card">
    <div class="signup__tape-left"></div>
    <div class="signup__tape-right"></div>
    <div class="signup__paper">
      {% if eyebrow %}<div class="hand-eyebrow">{{ eyebrow }}</div>{% endif %}
      <h2 class="cta-title">{{ title | accent }}</h2>
      {% if text %}<p class="cta-text">{{ text | newline_to_br }}</p>{% endif %}
      <a class="cta-accent" href="{{ button | link }}"{% if note %} aria-describedby="{{ block.id }}-note"{% endif %}>{{ button.label }} <span aria-hidden="true">→</span></a>
      {% if note %}<p class="signup__note" id="{{ block.id }}-note">{{ note | newline_to_br }}</p>{% endif %}
      {% if telegram %}{% assign telegram_href = telegram | link %}{% assign telegram_label = telegram.label | strip %}{% assign telegram_label_last = telegram_label | slice: -1 %}{% if telegram_label_last == '↗' %}{% assign telegram_label_cut = telegram_label.size | minus: 1 %}{% assign telegram_label = telegram_label | slice: 0, telegram_label_cut | strip %}{% endif %}<a class="signup__alt" href="{{ telegram_href }}"{% if telegram_href contains '://' %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ telegram_label }} <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
  </div>
</div>
