<div class="steps">
  <div class="section-head">
    <div>
      <h2 class="section-title">{{ title | accent }}</h2>
      <svg width="260" height="16" viewBox="0 0 260 16" class="section-underline" aria-hidden="true"><path d="M4 9 C 70 3, 170 4, 256 9" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"></path></svg>
    </div>
    {% if aside %}<div class="hand-aside">{{ aside | newline_to_br }}</div>{% endif %}
  </div>
  <ol class="steps__grid" role="list">
    {% for item in items %}
    {% assign look = forloop.index0 | modulo: 4 | plus: 1 %}
    <li class="step-card step-card--{{ look }}">
      <div class="step-card__tape"></div>
      <div class="step-card__number" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</div>
      <h3 class="step-card__title">{{ item.title }}</h3>
      <p class="step-card__text">{{ item.text | newline_to_br }}</p>
    </li>
    {% endfor %}
  </ol>
</div>
