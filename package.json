{
  "name": "averra-cms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check . && pnpm lint:styles",
    "lint:styles": "stylelint \"**/*.scss\"",
    "format": "biome check --write . && stylelint \"**/*.scss\" --fix",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "pnpm --filter @averra/e2e e2e",
    "db:generate": "pnpm --filter @averra/api db:generate",
    "user:create": "pnpm --filter @averra/api user:create",
    "user:password": "pnpm --filter @averra/api user:password",
    "site:create": "pnpm --filter @averra/api site:create",
    "member:add": "pnpm --filter @averra/api member:add",
    "member:invite": "pnpm --filter @averra/api member:invite",
    "token:create": "pnpm --filter @averra/api token:create",
    "token:list": "pnpm --filter @averra/api token:list",
    "token:revoke": "pnpm --filter @averra/api token:revoke",
    "mail:test": "pnpm --filter @averra/api mail:test",
    "fleet": "pnpm --filter @averra/deploy fleet"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "pnpm": "12.9.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
