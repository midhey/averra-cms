{
  "name": "cms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "pnpm --filter @cms/e2e e2e",
    "db:generate": "pnpm --filter @cms/api db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "pnpm": "12.9.1"
  }
}
